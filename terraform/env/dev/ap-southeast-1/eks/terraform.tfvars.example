aws_region         = "ap-southeast-1"
cluster_name       = "demo-eks-dev"
kubernetes_version = "1.33"

vpc_id             = "vpc-replace-with-vpc-output"
private_subnet_ids = ["subnet-replace-with-private-a", "subnet-replace-with-private-b"]

cluster_public_access_cidrs = ["REPLACE_WITH_YOUR_PUBLIC_IP/32"]
log_retention_days          = 7

tags = {
  Environment = "dev"
  Terraform   = "true"
}
